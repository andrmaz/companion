{
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"allowImportingTsExtensions": true,
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"outDir": "dist"
	},
	"include": ["src/**/*"]
}
